# ---------- REQUIRED ----------
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/eduledger

# Long random secret for login tokens (at least 32 characters).
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Websites allowed to call this API (comma separated, no / at the end)
ALLOWED_ORIGINS=http://localhost:5173

# ---------- OPTIONAL ----------
PORT=5000
NODE_ENV=development

# Only used once by "npm run seed:admin" to create the super admin
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
